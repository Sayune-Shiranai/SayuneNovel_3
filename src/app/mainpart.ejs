
  <div class="list-item-new row">
    <% libary.forEach(item => { %>
        <div class="detail-item-new col-lg-2">
            <div class="item-new-wrapper">
                <a href="/truyen/<%= item.slug %>" title="<%= item.itemname %>">
                <img
                    class="new-img"
                    src="/public/avt-item/<%= item.imgavt %>"
                ></img>
                </a>

                <div class="title-items-new">
                <div class="chapter-item-new" title="Chapter 1">
                    <a href="#">Chapter 1</a>
                </div>

                <div class="time-item-new">
                    <time
                    class="time-new"
                    title="12-07-2024 02:08:48"
                    datetime="2024-07-12T02:08:48+07:00"
                    >1 ngày</time
                    >
                </div>
                </div>
            </div>

            <div class="series-title-new">
                <a href="/truyen/<%= item.slug %>" title="<%= item.itemname %>">
                <%= item.itemname %>
                </a>
            </div>
        </div>
    <% }) %>
  </div>

