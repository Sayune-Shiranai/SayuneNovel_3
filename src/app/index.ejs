<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="" />
    <title>Sayune Novel</title>
    <!-- css boostrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/src/style/index.css" />
    <link rel="stylesheet" href="/src/style/base.css" />
    <link rel="stylesheet" href="/src/style/home.css" />
    <link rel="stylesheet" href="/src/style/mainpart.css" />
    <link rel="stylesheet" href="/src/style/book.css" />
    <link rel="stylesheet" href="/src/style/chapter.css" />
    <link
      rel="stylesheet"
      href="/src/style/icon/fontawesome-free-6.7.2-web/css/all.css"
    />
    <link rel="stylesheet" href="/src/style/icon/_fonts.scss" />

    <!-- js boostrap -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/simplebar/6.3.0/simplebar.min.css"
    />
    <!-- Select2 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
      rel="stylesheet"
    />

    <!-- js simplebar -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/simplebar/6.3.0/simplebar.min.js"></script>

    <!-- jQuery (cần cho Select2) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  </head>

  <body>
    <div id="main">
      <div id="header">
        <!-- begin nav -->
        <div id="nav">
          <div class="nav-logo">
            <a href="#"><img src="/public/img/logo.png" alt="logo" /></a>
          </div>

          <div class="nav-container text-14">
            <ul class="nav-menu">
              <li><a href="/">Trang chủ</a></li>
              <li>
                <a href="#"
                  >Thể loại
                  <i class="fa-solid fa-angle-down"></i>
                </a>

                <ul class="sub-nav-menu">
                  <% theloai.forEach(item => { %>
                  <li class="category"><a href="#"><%= item.theloai %></a></li>
                  <% }) %>
                </ul>
              </li>
              <li>
                <a href="#"> Tìm truyện </a>
              </li>
              <li><a href="#">Theo dõi</a></li>
              <li><a href="#">Lịch sử</a></li>
              <li><a href="#">Light Novel</a></li>
              <li>
                <a href="#">
                  Hướng dẫn
                  <i class="fa-solid fa-angle-down"></i>
                </a>

                <ul class="sub-nav-menu guide">
                  <li><a href="#">Giới thiệu</a></li>
                  <li><a href="#">Đăng truyện</a></li>
                  <li><a href="#">Góp ý - Báo lỗi</a></li>
                </ul>
              </li>
            </ul>
          </div>
        </div>

        <div id="nav-container-user">
          <div class="nav-search">
            <form action="/search" method="get" class="input-group">
              <input
                class="search-input text-14"
                type="text"
                name="keyword"
                placeholder="Search"
              />
              <button class="search-submit">
                <i class="fa-solid fa-magnifying-glass"></i>
              </button>
            </form>
          </div>

          <div class="nav-user">
            <ul>
              <% if (user) { %>
              <li class="user-dropdown dropdown">
                <a
                  href="#"
                  class="dropdown-toggle text-14"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                >
                  <i class="fa-solid fa-user"></i> <%= user.username %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end text-14">
                  <li>
                    <a class="dropdown-item" href="/profile">Trang cá nhân</a>
                  </li>
                  <li>
                    <a class="dropdown-item" href="/">Quản lý</a>
                  </li>
                  <li><hr class="dropdown-divider" /></li>
                  <li>
                    <form method="post" action="/logout">
                      <button type="submit" class="dropdown-item text-danger">
                        Đăng xuất
                      </button>
                    </form>
                  </li>
                </ul>
              </li>
              <% } else { %>
              <li>
                <a class="login-user text-14 js-login" href="/login"
                  >Đăng nhập</a
                >
              </li>
              <!-- <li><button class="sigup-user text-14 js-register">Đăng kí</button></li> -->
              <% } %>
            </ul>
          </div>
        </div>
      </div>

      <% if (partial === "home") { %> <%- include("banner") %> <% } %>
      <div id="mainpart">
        <% if (partial === "home") { %> <%- include("./mainpart", { libary,
        theloai})%> <% } else if (partial === "book") { %> <%- include("./book",
        { item, chapters, theloai, user}) %> <% } else if (partial ===
        "chapter") { %> <%- include("./chapter", { item, chapter, theloai}) %>
        <% } else if (partial === "search") { %> <%- include("./search", {
        search, keyword, searchResult}) %><% } %>
      </div>
    </div>
  </body>
</html>
