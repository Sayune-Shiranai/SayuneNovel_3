<!DOCTYPE html>
<html
  lang="vi"
  data-bs-theme="dark"
  data-sidebar-size="default"
  class="sidebar-enable"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="" />
    <title>Sayune Novel</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="/src/style/icon/fontawesome-free-6.7.2-web/css/all.css"
    />
    <link rel="stylesheet" href="/src/style/icon/_fonts.scss" />
    <link rel="stylesheet" href="/src/style/base.css" />
    <link rel="stylesheet" href="/src/style/login.css" />

    <!-- Simplebar CSS -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/simplebar/6.3.0/simplebar.min.css"
    />

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/simplebar/6.3.0/simplebar.min.js"></script>
    <script src="/src/components/menu-toggle.js"></script>
    <script src="/src/components/theme-toggle.js"></script>
  </head>

  <body>
    <% let _errorMessage = typeof errorMessage !== 'undefined' ? errorMessage :
    {}; let _formData = typeof formData !== 'undefined' ? formData : {}; %>

    <form action="/login" method="post">
      <div class="container">
        <div class="auth-body row justify-content-center">
          <div class="auth-form card">
            <div class="auth-form__header">
              <div class="auth-form__heading">
                <div class="auth-form__logo">
                  <a href="/">
                    <img src="/public/img/logo.png" alt="" />
                  </a>
                  <div class="auth-form__title">SayuneNovel</div>
                </div>
              </div>

              <span class="auth-form__notice">
                Nếu gặp bất cứ vấn đề gì khi đăng nhập/đăng ký, vui lòng liên hệ
                <a href="#">tại đây</a>.
              </span>
            </div>

            <div class="auth-form__form">
              <div class="auth-form__group">
                <input
                  type="text"
                  class="auth-form__input mb-3"
                  placeholder="Tên đăng nhập"
                  name="username"
                  value="<%= _formData.username || '' %>"
                />
                <% if (_errorMessage.username) { %>
                <p class="text-center text-danger">
                  <%= _errorMessage.username %>
                </p>
                <% } %>
              </div>

              <div class="auth-form__group">
                <input
                  type="password"
                  class="auth-form__input mb-3"
                  placeholder="Mật khẩu"
                  name="password"
                />
                <% if (_errorMessage.password) { %>
                <p class="text-center text-danger">
                  <%= _errorMessage.password %>
                </p>
                <% } %>
              </div>
            </div>

            <div class="mb-3 d-flex justify-content-between">
              <div class="form-submit-checkbox">
                <input
                  class="form-checkbox me-1"
                  type="checkbox"
                  id="RememberMe"
                  name="remember"
                />
                <label for="RememberMe">Tự động đăng nhập</label>
              </div>
              <a class="auth-form__submit-text" href="#">Quên mật khẩu?</a>
            </div>

            <div class="form-submit mb-3">
              <button class="auth-form__submit btn" type="submit">
                <span>Đăng nhập</span>
              </button>
            </div>

            <div class="form-submit-other text-center mb-3">
              <a href="/login/google" class="auth-form__submit btn">
                <span>Đăng nhập với Google</span>
              </a>
            </div>

            <div class="auth-form__submit-another mb-3">
              <span>
                Chưa có tài khoản? <a href="/register">Đăng ký ngay</a>
              </span>
            </div>
          </div>
        </div>
      </div>
    </form>
  </body>
</html>
