<div class="card">
  <div class="card-header">
    <h5 class="card-title">Thêm mới</h5>
    <p class="card-subtitle"></p>
  </div>

  <div class="card-body">
    <form
      action="/dashboard/add-item"
      method="post"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="id" class="form-label">Id</label>
        <input
          type="text"
          class="form-control"
          id="id"
          name="id"
          placeholder="Nhập id"
        />
      </div>

      <div class="mb-3">
        <label for="itemname" class="form-label">Tên truyện</label>
        <input
          type="text"
          class="form-control"
          id="itemname"
          name="itemname"
          placeholder="Nhập tên truyện"
        />
      </div>

      <div class="mb-3">
        <input
          type="file"
          class="form-control"
          id="imgavt"
          name="imgavt"
          accept="image/*"
          onchange="previewImage(event)"
        />
        <img
          src=""
          alt=""
          id="preview-img"
          style="max-width: 100px; padding: 12px; display: none"
        />
      </div>

      <div class="mb-3">
        <label for="theloai" class="form-label">Thể loại</label>
        <select
          class="form-select js-multiple-select"
          id="theloai"
          name="theloai[]"
          multiple
        >
          <% categories.forEach(item => { %>
          <option value="<%= item.theloai %>"><%= item.theloai %></option>
          <% }) %>
        </select>
      </div>

      <div class="mb-3">
        <label for="tacgia" class="form-label">Tác giả</label>
        <input
          type="text"
          class="form-control"
          id="tacgia"
          name="tacgia"
          placeholder="Nhập tên tác giả"
        />
      </div>

      <div class="mb-3">
        <label for="trangthai" class="form-label">Trạng thái</label>
        <select class="form-select" id="trangthai" name="trangthai" required>
          <option value="Đang tiến hành">Đang tiến hành</option>
          <option value="Đã hoàn thành">Đã hoàn thành</option>
        </select>
      </div>

      <div class="mb-3">
        <label for="noidung" class="form-label">Nội dung</label>
        <textarea
          name="noidung"
          id="noidung"
          placeholder="Nhập mô tả nội dung"
        ></textarea>
        <!-- <input type="text" class="form-control" id="noidung" name="noidung" /> -->
      </div>
      <button type="submit" class="btn btn-primary">Thêm</button>
    </form>
  </div>
</div>

<script>
  $(document).ready(function () {
    $(".js-multiple-select").select2({
      placeholder: "Chọn thể loại",
      width: "100%",
    });
  });

  function previewImage(event) {
    const reader = new FileReader();
    reader.onload = function () {
      const img = document.getElementById("preview-img");
      img.src = reader.result;
      img.style.display = "block"; // Hiện ảnh khi chọn
    };
    reader.readAsDataURL(event.target.files[0]);
  }
</script>
