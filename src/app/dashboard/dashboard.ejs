<!DOCTYPE html>
<html
  lang="vi"
  data-bs-theme="dark"
  data-sidebar-size="default"
  class="sidebar-enable"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="" />
    <title>Sayune Novel</title>
    <!-- css boostrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="/src/style/icon/fontawesome-free-6.7.2-web/css/all.css"
    />
    <link rel="stylesheet" href="/src/style/icon/_fonts.scss" />
    <link rel="stylesheet" href="/src/style/dashboard.css" />
    <link rel="stylesheet" href="/src/style/base.css" />
    <link rel="stylesheet" href="/src/style/topbar.css" />
    <link rel="stylesheet" href="/src/style/sidebar.css" />
    <link rel="stylesheet" href="/src/style/pagecontent.css" />
    <link rel="stylesheet" href="/src/style/member.css" />
    <link rel="stylesheet" href="/src/style/create-item.css" />
    <!--css simplebar -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/simplebar/6.3.0/simplebar.min.css"
    />
    <!-- Select2 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
      rel="stylesheet"
    />

    <!-- js boostrap -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>

    <!-- js simplebar -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/simplebar/6.3.0/simplebar.min.js"></script>

    <!-- jQuery (cần cho Select2) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="/public/js/menu-toggle.js"></script>
    <script src="/public/js/theme-toggle.js"></script>
  </head>

  <body>
    <div id="app-wrapper">
      <!-- Topbar Start -->
      <%- include("topbar") %>
      <!-- Sidebar start -->
      <%- include("sidebar") %>
      <!-- Page content start -->
      <div class="page-content">
        <div class="container-fluid">
          <!-- libary -->
          <% if (partial === "libary") { %> <%- include("./libary", { libary
          })%>
          <!-- create-item -->
          <% } else if (partial === "create-item") { %> <%-
          include("./create-item") %>
          <!-- update-item -->
          <% } else if (partial === "update-item") { %> <%-
          include("./update-item", { categories, item }) %>
          <!-- category -->
          <% } else if (partial === "categories") { %> <%- include("./category",
          { categories }) %>
          <!-- create-category -->
          <% } else if (partial === "create-category") { %> <%-
          include("./create-category") %>
          <!-- update-category -->
          <% } else if (partial === "update-category") { %> <%-
          include("./update-category", { category }) %>
          <!-- category -->
          <% } else if (partial === "chapters") { %> <%- include("./chapters", {
          chapters, slug }) %>
          <!-- create-category -->
          <% } else if (partial === "add-chapter") { %> <%-
          include("./create-chapter", { slug }) %>
          <!-- member -->
          <% } else if (partial === "member") { %> <%- include("./member", {
          users }) %>
          <!-- update-member -->
          <% } else if (partial === "update-member") { %> <%-
          include("./update-member", { user }) %> <% } %>
        </div>
      </div>
    </div>
  </body>
</html>
