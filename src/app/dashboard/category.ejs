<div class="card">
  <div class="card-header">
    <h5 class="card-title">Thể loại</h5>
    <p class="card-subtitle"></p>
    <a href="/dashboard/add-category" class="btn btn-primary">Thêm</a>
  </div>

  <div class="card-body">
    <table class="table table-hover table-dark">
      <thead>
        <tr>
          <th scope="col">Id</th>
          <th scope="col">Thể loại</th>

          <!-- <th scope="col">Date joined</th> -->
          <!-- <th scope="col">Last login</th> -->
          <th scope="col">Action</th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach((item, index) => { %>
        <tr>
          <th scope="row"><%= index + 1 %></th>
          <td><%= item.theloai %></td>

          <td>
            <a href="/dashboard/category/update/<%= item._id %>">Update</a>
            <a href="/dashboard/category/delete/<%= item._id %>">Delete</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
